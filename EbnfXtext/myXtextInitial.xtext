grammar org.strategy.StrategyGame with org.eclipse.xtext.common.Terminals

generate strategyGame "https://www.sdu.dk/da/strategyGame"

Game:
    'StrategyGameTextbasedPrototype'
    createGame=CreateGame
    assignEachPlayerObjects=AssignEachPlayerObjects
    setRandomness=SetRandomness
    setDecisions=SetDecisions
    setWinningLosing=SetWinningLosing
;

CreateGame:
    'CreateGame' '('
        'StartingResources:' startingResources=ResourceList ','
        'MaxResources:' maxResources=ResourceList ','
        'TimeSetup:' timeSetup=TimeSetup
    ')'
;

ResourceList:
    resources+=Resource (',' resources+=Resource)*
;

AssignEachPlayerObjects:
    'AssignEachPlayerObjects' '('
        'Units:' units+=Unit (',' units+=Unit)*
    ')'
;

SetRandomness:
    'SetRandomness' '('
        'Randomness:' attacking=[Unit|ID]
        'vs' defending=[Resource|ID]
        '->' result=RandomValueRange
    ')'
;

SetDecisions:
    'SetDecisions' '('
        decisions+=Decision*
    ')'
;

SetWinningLosing:
    'SetWinningLosing' '('
        conditions+=Condition*
    ')'
;

TimeSetup:
      'TurnBased' turns=INT
    | 'RealTime'
;

Resource:
    name=ID '=' amount=INT
;

Unit:
    'unit' name=ID
;

Decision:
    'decision' name=ID
;

Condition:
    'condition' name=ID
;

RandomValueRange:
      value=INT
    | min=INT '..' max=INT
;