grammar org.example.games.Games with org.eclipse.xtext.common.Terminals

generate games "http://www.example.org/games/Games"

Model:
    elements+=TopLevel*
;

TopLevel:
      Game
    | Setup
    | Rule
    | Player
    | Decisions
    | IntVar
    | Script
    | Condition
    | Decision
        // From previous xtext
    //| Unit
    //| Resource
;



Game:
    'game' name=ID '{'
        'setup'     '{' setup=[Setup|ID]        '}'
        'rule'      '{' rule=[Rule|ID]          '}'
        'decisions' '{' decisions=[Decisions|ID] '}'
        'script'    '{' script=[Script|ID]      '}'
    '}'
;

Setup:
    'setup' name=ID '{'
        vars+=IntVar*
        ('timelimit' limitName=ID)?            // <-- plain ID, no [IntVar|ID]
        'player1' '{' player1=[Player|ID] '}'
        'player2' '{' player2=[Player|ID] '}'
    '}'
;



enum VarKind: VAR | RESOURCE | MILITARY;

IntVar:
    kind=VarKind
    (
        'var'      name=ID
      | 'Resource' '[' name=ID ']'
      | 'Military' '[' name=ID ']'
    )
    '=' init=Expression ';'
;


Assignment:
    target=LValue '=' expression=Expression ';'
;



Player:
    'player' name=ID '{'
        vars+=IntVar*
        'health' '=' health=INT
        'resources' '{' resources+=IntVar* '}'
        ('military' '{' militaryResources+=IntVar* '}')?
    '}'
;


Rule:
    'rule' name=ID '{'
        'win'  ':' winCondition=[Condition|ID]
        'lose' ':' loseCondition=[Condition|ID]
    '}'
;

Condition:
    'condition' name=ID boolexp=Expression ';'
;



Decisions:
    'decisions' name=ID '{'
        decisions+=[Decision|ID] (',' decisions+=[Decision|ID])*
    '}'
;

Decision:
    'decision' name=ID body=Block
;



Block:
    '{' statements+=Statement* '}'
;

ExpressionStmt:
    expr=Expression ';'
;

Statement:
      Conditional
    | PrintStmt
    | ExpressionStmt
    | IntVar
    | Assignment
;

PrintStmt:
    'print' value=STRING ';'
;



Script:
    'script' name=ID '{'
        turns+=Turns*
    '}'
;

Turns:
    'turn' index=INT ':'
        player=[Player|ID]
        decision=[Decision|ID]
        ';'
;



Conditional:
    'if' '(' condition=Expression ')'
        thenBlock=Block
        ('elif' '(' elifConditions+=Expression ')' elifBlocks+=Block)*
        ('else' elseBlock=Block)?
;




LValue:
      {PlayerVarLValue} player=[Player|ID] '.' varName=ID   
    | {VarLValue}      varName=ID                          
;



Expression:
    OrExpression
;

OrExpression returns Expression:
    AndExpression ({OrExpression.left=current} 'or' right=AndExpression)*
;

AndExpression returns Expression:
    ComparisonExpression ({AndExpression.left=current} 'and' right=ComparisonExpression)*
;

ComparisonExpression returns Expression:
    Addition ({Comparison.left=current} op=('=='|'!='|'<'|'>') right=Addition)*
;

Addition returns Expression:
    Multiplication (({Plus.left=current} '+' | {Minus.left=current} '-') right=Multiplication)*
;

Multiplication returns Expression:
    Primary (({Mult.left=current} '*' | {Div.left=current} '/') right=Primary)*
;

Primary returns Expression:
      '(' Expression ')'
    | {IntConstant}  value=INT
    | {BoolConstant} value=('true'|'false')
    | {LValueExpr}   target=LValue
    | {Not} '!' expression=Primary
;

/*
StrategyGame:
    'StrategyGameTextbasedPrototype'
    createGame=CreateGame
    assignEachPlayerObjects=AssignEachPlayerObjects
    setRandomness=SetRandomness
    setDecisions=SetStrategyDecisions
    setWinningLosing=SetStrategyWinningLosing
;

