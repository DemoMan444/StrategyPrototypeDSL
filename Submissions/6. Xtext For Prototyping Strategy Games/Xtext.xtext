    'CreateGame' '('
        'StartingResources:' startingResources=ResourceList ','
        'MaxResources:' maxResources=ResourceList
    ')'
;

ResourceList:
    resources+=StrategyResource (',' resources+=StrategyResource)*
;

AssignEachPlayerObjects:
    'AssignEachPlayerObjects' '('
        'Units:' units+=StrategyUnit (',' units+=StrategyUnit)*
    ')'
;

SetRandomness:
    'SetRandomness' '('
        'Randomness:' attacking=[StrategyUnit|ID]
        'vs' defending=[StrategyResource|ID]
        '->' result=RandomValueRange
    ')'
;

Resource:
    name=ID '=' amount=INT
;

Unit:
    'unit' name=ID
;

RandomValueRange:
      value=INT
    | min=INT '..' max=INT
;
